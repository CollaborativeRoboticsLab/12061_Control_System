# ---- Build output -----------------------------------------------------------
.pio/
build_gcc/
*.o
*.elf
*.bin
*.hex
*.map

# ---- Editor state -------------------------------------------------------------
# Matches at any depth, so it covers both the stale copy left at the repo root
# by the old layout and the one PlatformIO creates inside source_code/.
.vscode/

# ---- MATLAB ------------------------------------------------------------------
*.asv
*.autosave
*.slxc
slprj/
MATLAB_Code/slprj/
MATLAB_Code/bluepill/
MATLAB_Code/simulink/
MATLAB_Code/diagnostics/

# ---- Lab captures ------------------------------------------------------------
# Every student run writes .mat/.csv here. It is their data, not repository
# content, and it would collide between groups.
MATLAB_Code/Labs/*/data/
MATLAB_Code/Labs/*/*_Data/
MATLAB_Code/Lab*_Data/
MATLAB_Code/Labs/week5/Control_System_Lab3_QA.m

# ---- Staff-only notes --------------------------------------------------------
# CHANGES.md is the Chinese porting log: what changed relative to the WHEELTEC
# original and why. Useful to whoever maintains the firmware, not to students.
# README.md is deliberately NOT ignored - it is the repository landing page.
# readme-repo.md is the Chinese README.
CHANGES.md
readme-repo.md

# ---- Vendor binaries ---------------------------------------------------------
# stsw-link009.zip is ST's own ST-Link USB driver package (5 MB) under ST's
# licence, not ours to redistribute, and it would sit in the history of a
# repository that is otherwise about 1 MB of text. Keep a copy with the lab
# materials instead; README.md says where to get it.
# *.zip

# ---- OS / OneDrive junk ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.bak
~$*
